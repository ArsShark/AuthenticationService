# Copy this file to .env (it is ignored by Git) and set the passwords and the keys.
# Docker Compose reads .env automatically. Variables set in the shell win over .env.
# A value with a dollar sign or a hash sign must be put in single quotes, for example
# ADMIN_PASSWORD='pa$$word#1': otherwise Compose treats "$" as a variable and cuts the value at "#".
DB_NAME=auth_service_db
DB_USERNAME=auth_service
DB_PASSWORD=change-me

# The shared key of the internal endpoints (header X-Internal-Key). It must be the same value as
# INTERNAL_API_KEY of the Gateway and of User Service. Generate one with:
#   openssl rand -base64 32
INTERNAL_API_KEY=change-me-internal-key

# The RSA private key that signs the tokens: PKCS#8 DER, base64, on ONE line (see the README,
# "The signing key"). The placeholder is not valid base64 on purpose: the service refuses to start
# until it is replaced. Never commit a real key. A new key means a new key id: tokens signed with
# the old key stop working.
JWT_PRIVATE_KEY=change-me

# Optional. The defaults are PT15M, P7D and authentication-service. The issuer must be the same as
# JWT_ISSUER of the other services.
#JWT_ACCESS_TTL=PT15M
#JWT_REFRESH_TTL=P7D
#JWT_ISSUER=authentication-service

# The first admin (the login is an email): set both or neither. Both empty means that no admin is
# created. The password needs at least 8 characters.
ADMIN_LOGIN=
ADMIN_PASSWORD=
